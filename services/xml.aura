export fn renderSqsSendMessage(msgId: String): String => {
  let inner = xmlWrap("MD5OfMessageBody", "7b226f726465724964223a343931327d") +
  xmlWrap("MessageId", msgId);
  let result = xmlWrap("SendMessageResult", inner);
  let meta = xmlWrap("ResponseMetadata", xmlWrap("RequestId", generateUuid()));
  `<?xml version="1.0" encoding="UTF-8"?>\n<SendMessageResponse>\n${result}\n${meta}\n</SendMessageResponse>`
};

export fn renderSqsDeleteMessage(): String => {
  let meta = xmlWrap("ResponseMetadata", xmlWrap("RequestId", generateUuid()));
  `<?xml version="1.0" encoding="UTF-8"?>\n<DeleteMessageResponse>\n${meta}\n</DeleteMessageResponse>`
};

