export fn renderSnsListSubscriptions(): String => {
  let s = getState();
  let mut subsXml = "";
  for t in s.snsTopics {
    for sub in t.subscriptions {
      let item = xmlWrap("SubscriptionArn", sub.subscriptionArn) +
      xmlWrap("Owner", "000000000000") +
      xmlWrap("Protocol", sub.protocol) +
      xmlWrap("Endpoint", sub.endpoint) +
      xmlWrap("TopicArn", t.arn);
      subsXml = subsXml + xmlWrap("member", item);
    }
  }
  let result = xmlWrap("ListSubscriptionsResult", xmlWrap("Subscriptions", subsXml));
  let meta = xmlWrap("ResponseMetadata", xmlWrap("RequestId", generateUuid()));
  `<?xml version="1.0" encoding="UTF-8"?>\n<ListSubscriptionsResponse xmlns="http://sns.amazonaws.com/doc/2010-03-31/">\n${result}\n${meta}\n</ListSubscriptionsResponse>`
};

export fn renderIamCreateRole(role: Any): String => {
  let r = xmlWrap("RoleId", role.roleId) +
  xmlWrap("Arn", role.arn) +
  xmlWrap("RoleName", role.roleName) +
  xmlWrap("CreateDate", role.createdAt) +
  xmlWrap("AssumeRolePolicyDocument", role.assumeRolePolicyDocument);
  let result = xmlWrap("CreateRoleResult", xmlWrap("Role", r));
  let meta = xmlWrap("ResponseMetadata", xmlWrap("RequestId", generateUuid()));
  `<?xml version="1.0" encoding="UTF-8"?>\n<CreateRoleResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/">\n${result}\n${meta}\n</CreateRoleResponse>`
};

export fn renderIamListRoles(): String => {
  let s = getState();
  let mut rolesXml = "";
  for r in s.iamRoles {
    let item = xmlWrap("RoleId", r.roleId) +
    xmlWrap("Arn", r.arn) +
    xmlWrap("RoleName", r.roleName) +
    xmlWrap("CreateDate", r.createdAt);
    rolesXml = rolesXml + xmlWrap("member", item);
  }
  let result = xmlWrap("ListRolesResult", xmlWrap("Roles", rolesXml));
  let meta = xmlWrap("ResponseMetadata", xmlWrap("RequestId", generateUuid()));
  `<?xml version="1.0" encoding="UTF-8"?>\n<ListRolesResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/">\n${result}\n${meta}\n</ListRolesResponse>`
};
