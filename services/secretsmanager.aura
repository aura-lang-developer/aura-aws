// ==============================================================================
// FLOCI-AURA: AWS Secrets Manager Service Handler
// ==============================================================================

import { getState } from "./state";
import { auditRequest, logEvent, generateUuid, defaultStr } from "./utils";

export fn handleSecretsManager(req: Any, res: Any, target: String, payload: Any): Unit => {
  let s = getState();
  auditRequest(req, "SecretsManager", 200);

  if (target.endsWith("CreateSecret")) {
    let sName = payload.Name;
    let sArn = `arn:aws:secretsmanager:us-east-1:000000000000:secret:${sName}`;
    let item = {
      name: sName,
      arn: sArn,
      value: defaultStr(payload.SecretString, ""),
      description: defaultStr(payload.Description, ""),
      versionId: generateUuid(),
      createdAt: "2026-09-18T12:00:00.000Z"
    };
    s.secrets.push(item);
    logEvent("SECRETS", "info", `Stored secret '${sName}'`);
    http.json(res, http.StatusOK, {ARN: sArn, Name: sName, VersionId: item.versionId});
    return();
  }

  if (target.endsWith("GetSecretValue")) {
    let sId = payload.SecretId;
    let matched = s.secrets.filter(fn(s: Any): Bool => s.name == sId || s.arn == sId);
    if (matched.length > 0) {
      let sc = matched[0];
      http.json(res, http.StatusOK, {
        ARN: sc.arn,
        Name: sc.name,
        SecretString: sc.value,
        VersionId: sc.versionId,
        CreatedDate: 1726660800
      });
    }else {
      http.json(res, http.StatusNotFound, {
        __type: "ResourceNotFoundException",
        Message: `Secret '${sId}' not found`
      });
    }
    return();
  }

  if (target.endsWith("ListSecrets")) {
    let list = s.secrets.map(fn(sc: Any): Any => {ARN: sc.arn, Name: sc.name, Description: sc.description});
    http.json(res, http.StatusOK, {SecretList: list});
    return();
  }

  if (target.endsWith("PutSecretValue")) {
    let sId = payload.SecretId;
    let val = defaultStr(payload.SecretString, "");
    let matched = s.secrets.filter(fn(sc: Any): Bool => sc.name == sId || sc.arn == sId);
    if (matched.length > 0) {
      let sc = matched[0];
      sc.value = val;
      sc.versionId = generateUuid();
      logEvent("SECRETS", "info", `Updated secret value for '${sc.name}'`);
      http.json(res, http.StatusOK, {ARN: sc.arn, Name: sc.name, VersionId: sc.versionId});
    }else {
      http.json(res, http.StatusNotFound, {__type: "ResourceNotFoundException", Message: `Secret '${sId}' not found`});
    }
    return();
  }

  if (target.endsWith("DeleteSecret")) {
    let sId = payload.SecretId;
    let sArn = `arn:aws:secretsmanager:us-east-1:000000000000:secret:${sId}`;
    s.secrets = s.secrets.filter(fn(sc: Any): Bool => sc.name != sId && sc.arn != sId);
    logEvent("SECRETS", "info", `Deleted secret '${sId}'`);
    http.json(res, http.StatusOK, {ARN: sArn, Name: sId, DeletionDate: 1726660800});
    return();
  }

  http.json(res, http.StatusOK, {});
};
