  totalRequestsCount: 0,
  bootTimestamp: time.now(),
  nextIdCounter: 1000
};

export fn getState(): Any => {
  storeInstance
};

export fn incrementRequestsCount(): Unit => {
  storeInstance.totalRequestsCount = storeInstance.totalRequestsCount + 1;
};

export fn clearRequestAuditLog(): Unit => {
  storeInstance.requestAuditLog = [];
};

export fn resetState(): Unit => {
  storeInstance.s3Buckets = [];
  storeInstance.s3Objects = [];
  storeInstance.dynamoTables = [];
  storeInstance.sqsQueues = [];
  storeInstance.snsTopics = [];
  storeInstance.lambdaFunctions = [];
  storeInstance.secrets = [];
  storeInstance.ssmParameters = [];
  storeInstance.kmsKeys = [];
  storeInstance.eventBuses = [];
  storeInstance.iamUsers = [];
  storeInstance.iamRoles = [];
  storeInstance.requestAuditLog = [];
  storeInstance.liveLogs = [];
};
